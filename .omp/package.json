{
  "name": "derate-design-pack",
  "private": true,
  "type": "module",
  "scripts": {
    "tokens:build": "node design/tokens/build.mjs",
    "tokens:check": "node design/tokens/check.mjs",
    "icons:build": "node design/icons/build.mjs",
    "icons:lint": "node design/icons/lint.mjs",
    "styleguide:build": "node design/styleguide.mjs",
    "audit": "node design/audit.mjs",
    "graph:build": "node graph/build.mjs --full",
    "graph:update": "node graph/build.mjs",
    "ui:static": "node tests/ui/static/lint.mjs ../ui/src",
    "ui:new": "node tests/ui/scaffold.mjs",
    "ui:check": "node tests/ui/run.mjs",
    "pack:sync": "node pack-sync.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm run ui:check"
  },
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": "18.16.0",
    "axe-core": "^4.10.0",
    "esbuild": "^0.25.12",
    "playwright-core": "^1.63.0",
    "svgo": "^3.3.2",
    "typescript": "^5.6.3"
  }
}
