{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Chart pack tokens. Every role aliases the design pack ({design.<name>} resolves against ../../design/tokens/tokens.flat.json) except the data palettes, which the design pack does not have: an 8-colour categorical set tuned per theme for >=3:1 contrast against the chart surface (4.5:1 in high-contrast) and colour-vision-deficiency separation (gated by build.mjs), plus sequential and diverging ramps interpolated in OKLab between the stops below. Build: cd .omp/charts && npm run theme:build. A $value keyed light/dark/high-contrast differs per theme.",
  "chart": {
    "surface": { "$type": "color", "$value": "{design.panel}", "$description": "the surface charts are drawn on; contrast is measured against it" },
    "surface-raised": { "$type": "color", "$value": "{design.panel-raised}", "$description": "empty/error state plate, legend chips" },
    "ink": { "$type": "color", "$value": "{design.ink}", "$description": "titles, values, direct labels" },
    "ink-secondary": { "$type": "color", "$value": "{design.ink-secondary}", "$description": "tick labels" },
    "ink-muted": { "$type": "color", "$value": "{design.ink-muted}", "$description": "axis titles, notes, de-emphasised marks" },
    "grid": { "$type": "color", "$value": "{design.rule}", "$description": "gridlines" },
    "axis": { "$type": "color", "$value": "{design.edge}", "$description": "axis domain lines and ticks" },
    "rule-strong": { "$type": "color", "$value": "{design.rule-strong}", "$description": "zero lines, separators" },
    "track": { "$type": "color", "$value": "{design.bar-track}", "$description": "unfilled part of progress, gauge and bullet tracks" },
    "focus": { "$type": "color", "$value": "{design.focus-ring}", "$description": "keyboard focus ring around the active mark" },
    "focus-width": { "$type": "dimension", "$value": "{design.focus-ring-width}", "$description": "focus ring width" },
    "tooltip-bg": { "$type": "color", "$value": "{design.panel-raised}", "$description": "tooltip plate: the raised panel of the theme in force, as the app's popovers draw it (it was inverted -- cream on a dark page)" },
    "tooltip-fg": { "$type": "color", "$value": "{design.ink}", "$description": "tooltip text" },
    "tooltip-border": { "$type": "color", "$value": "{design.rule}", "$description": "tooltip edge, so a same-colour plate still separates from the chart" },
    "tooltip-shadow": { "$type": "shadow", "$value": "{design.shadow-raised}", "$description": "tooltip lift, the app's popover shadow" },
    "tooltip-radius": { "$type": "dimension", "$value": "{design.tooltip-radius}", "$description": "tooltip corner" },
    "radius": { "$type": "dimension", "$value": "{design.radius-sm}", "$description": "bar and tile corner" },
    "positive": { "$type": "color", "$value": "{design.live}", "$description": "increase, up candle, above target" },
    "negative": { "$type": "color", "$value": "{design.fault}", "$description": "decrease, down candle, out of control" },
    "warning": { "$type": "color", "$value": "{design.warn}", "$description": "warning bands and thresholds" },
    "neutral": { "$type": "color", "$value": "{design.ink-muted}", "$description": "totals, baselines, 'other'" },
    "highlight": { "$type": "color", "$value": "{design.accent}", "$description": "today marker, selection, brush" },
    "font": { "$type": "fontFamily", "$value": "{design.font-sans}", "$description": "all chart text" },
    "font-mono": { "$type": "fontFamily", "$value": "{design.font-mono}", "$description": "tabular figures in tooltips and tables" },
    "size-tick": { "$type": "dimension", "$value": "{design.size-micro}", "$description": "tick labels" },
    "size-label": { "$type": "dimension", "$value": "{design.size-unit}", "$description": "direct labels, legend" },
    "size-title": { "$type": "dimension", "$value": "{design.size-label}", "$description": "axis titles" },
    "size-value": { "$type": "dimension", "$value": "{design.size-readout}", "$description": "KPI and gauge readouts" },
    "dur": { "$type": "duration", "$value": "{design.dur-slow}", "$description": "enter/update/exit transitions; zero under prefers-reduced-motion" },
    "dur-fast": { "$type": "duration", "$value": "{design.dur-fast}", "$description": "hover highlight" },
    "ease": { "$type": "cubicBezier", "$value": "{design.ease}", "$description": "transition easing" },
    "cat": {
      "$type": "color",
      "$description": "Categorical palette, assigned in this order. Hue-anchored to Okabe-Ito, lightness/chroma tuned per theme.",
      "1": { "$value": { "light": "#004D7A", "dark": "#1C99E8", "high-contrast": "#256391" }, "$description": "blue" },
      "2": { "$value": { "light": "#8A600F", "dark": "#EBAB3F", "high-contrast": "#846330" }, "$description": "orange" },
      "3": { "$value": { "light": "#45876D", "dark": "#5EF3BD", "high-contrast": "#1A6047" }, "$description": "green" },
      "4": { "$value": { "light": "#743102", "dark": "#DB6B26", "high-contrast": "#AE4B01" }, "$description": "vermillion" },
      "5": { "$value": { "light": "#108DC5", "dark": "#5FC5FE", "high-contrast": "#197BAB" }, "$description": "sky" },
      "6": { "$value": { "light": "#F02EAE", "dark": "#BA6695", "high-contrast": "#8F316A" }, "$description": "magenta" },
      "7": { "$value": { "light": "#908804", "dark": "#F4E619", "high-contrast": "#7D7839" }, "$description": "yellow" },
      "8": { "$value": { "light": "#5D5A54", "dark": "#AEACA5", "high-contrast": "#706E68" }, "$description": "grey" }
    },
    "seq": {
      "$type": "color",
      "$description": "Sequential ramp stops; build.mjs emits 9 steps (--oc-seq-0..8) interpolated in OKLab.",
      "start": { "$value": { "light": "{design.panel-recessed}", "dark": "#1B2630", "high-contrast": "#EEF3F8" } },
      "end": { "$value": { "light": "#0B3B5E", "dark": "#A9DBFF", "high-contrast": "#00264D" } }
    },
    "div": {
      "$type": "color",
      "$description": "Diverging ramp stops; build.mjs emits 11 steps (--oc-div-0..10), low -> mid -> high.",
      "low": { "$value": "{design.fault}" },
      "mid": { "$value": { "light": "{design.panel-recessed}", "dark": "#2A2826", "high-contrast": "#F2F2F2" } },
      "high": { "$value": "{design.info}" }
    }
  }
}
