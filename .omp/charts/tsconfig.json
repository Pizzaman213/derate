{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "allowJs": false,
    "isolatedModules": true,
    "types": ["node"]
  },
  "include": ["index.ts", "core", "adapters", "time", "chooser", "types", "tests", "datasets/*.ts", "geo/*.ts", "theme/*.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "dist"]
}
