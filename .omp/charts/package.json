{
  "name": "derate-chart-pack",
  "private": true,
  "type": "module",
  "description": "Every major chart type behind one API. TypeScript + D3 -> SVG, canvas above 5k marks. See README.md and RULES.md.",
  "scripts": {
    "theme:build": "node theme/build.mjs",
    "charts:build": "node scripts/build.mjs",
    "charts:typecheck": "tsc -p tsconfig.json",
    "charts:test": "vitest run",
    "charts:visual": "node tests/browser/run.mjs --suite visual,layout",
    "charts:a11y": "node tests/browser/run.mjs --suite a11y",
    "charts:perf": "node tests/browser/run.mjs --suite perf",
    "charts:icons": "node icons/lint.mjs --write && node icons/lint.mjs",
    "charts:registry": "node scripts/registry.mjs",
    "charts:gallery": "node scripts/build.mjs && node icons/lint.mjs --write && node scripts/gallery.mjs",
    "charts:check": "node scripts/check.mjs",
    "charts:cli": "node scripts/cli.mjs",
    "charts:gallery:verify": "node tests/browser/gallery.mjs"
  },
  "dependencies": {
    "@upsetjs/venn.js": "^1.4.2",
    "d3-array": "^3.2.4",
    "d3-brush": "^3.0.0",
    "d3-chord": "^3.0.1",
    "d3-cloud": "^1.2.7",
    "d3-contour": "^4.0.2",
    "d3-delaunay": "^6.0.4",
    "d3-dsv": "^3.0.1",
    "d3-ease": "^3.0.1",
    "d3-force": "^3.0.0",
    "d3-format": "^3.1.0",
    "d3-geo": "^3.1.1",
    "d3-hexbin": "^0.2.2",
    "d3-hierarchy": "^3.1.2",
    "d3-interpolate": "^3.0.1",
    "d3-quadtree": "^3.0.2",
    "d3-sankey": "^0.12.3",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.2.0",
    "d3-time": "^3.1.0",
    "d3-time-format": "^4.1.0",
    "d3-transition": "^3.0.1",
    "d3-zoom": "^3.0.0",
    "topojson-client": "^3.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/d3-array": "^3.2.2",
    "@types/d3-brush": "^3.0.6",
    "@types/d3-chord": "^3.0.6",
    "@types/d3-cloud": "^1.2.9",
    "@types/d3-contour": "^3.0.6",
    "@types/d3-delaunay": "^6.0.4",
    "@types/d3-dsv": "^3.0.7",
    "@types/d3-ease": "^3.0.2",
    "@types/d3-force": "^3.0.10",
    "@types/d3-format": "^3.0.4",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-hexbin": "^0.2.5",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-interpolate": "^3.0.4",
    "@types/d3-quadtree": "^3.0.6",
    "@types/d3-sankey": "^0.12.5",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-shape": "^3.2.0",
    "@types/d3-time": "^3.0.4",
    "@types/d3-time-format": "^4.0.3",
    "@types/d3-transition": "^3.0.9",
    "@types/d3-zoom": "^3.0.9",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^20.19.43",
    "@types/pngjs": "^6.0.5",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "axe-core": "^4.14.1",
    "esbuild": "^0.25.12",
    "jsdom": "^29.1.1",
    "pixelmatch": "^8.0.0",
    "playwright-core": "^1.65.1",
    "pngjs": "^7.0.0",
    "svgo": "^4.1.0",
    "typescript": "^5.9.3",
    "us-atlas": "^3.0.1",
    "vitest": "^4.1.12",
    "world-atlas": "^2.0.2"
  }
}
