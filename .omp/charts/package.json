{
  "name": "derate-chart-pack",
  "private": true,
  "type": "module",
  "description": "The chart types the app mounts, one file each, behind one API. TypeScript + D3 -> SVG, canvas above 5k marks. See README.md and RULES.md.",
  "scripts": {
    "theme:build": "node theme/build.mjs",
    "charts:typecheck": "tsc -p tsconfig.json",
    "charts:test": "vitest run"
  },
  "dependencies": {
    "d3-array": "^3.2.4",
    "d3-brush": "^3.0.0",
    "d3-dsv": "^3.0.1",
    "d3-format": "^3.1.0",
    "d3-quadtree": "^3.0.2",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.2.0",
    "d3-transition": "^3.0.1",
    "d3-zoom": "^3.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/d3-array": "^3.2.2",
    "@types/d3-brush": "^3.0.6",
    "@types/d3-dsv": "^3.0.7",
    "@types/d3-format": "^3.0.4",
    "@types/d3-quadtree": "^3.0.6",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-shape": "^3.2.0",
    "@types/d3-transition": "^3.0.9",
    "@types/d3-zoom": "^3.0.9",
    "@types/node": "^20.19.43",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
