{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "react": ["../ui/node_modules/@types/react"],
      "react/jsx-runtime": ["../ui/node_modules/@types/react/jsx-runtime"],
      "react-dom": ["../ui/node_modules/@types/react-dom"],
      "react-dom/client": ["../ui/node_modules/@types/react-dom/client"],
      "react-dom/server": ["../ui/node_modules/@types/react-dom/server"],
      "*": ["../ui/node_modules/*"]
    },
    "typeRoots": ["../ui/node_modules/@types", "node_modules/@types"]
  },
  "include": ["extensions", "tests/ui/**/*.ts", "tests/ui/**/*.tsx", "design/**/*.ts"]
}
